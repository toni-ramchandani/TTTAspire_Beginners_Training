# Choose: ollama or openai
RAG_PROVIDER=ollama

# Retrieval
RAG_TOP_K=3
RAG_REQUEST_TIMEOUT_SECONDS=120

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# OpenAI configuration
# Never commit a real key. Put it only in your local .env file.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ragas evaluator. The judge is independent of the RAG provider.
RAGAS_JUDGE_PROVIDER=ollama
RAGAS_REQUEST_TIMEOUT_SECONDS=180
RAGAS_MAX_RETRIES=2
RAGAS_MAX_TOKENS=4096

# Ollama judge through its OpenAI-compatible /v1 endpoint.
# A larger local judge can improve metric stability; change the model here.
RAGAS_OLLAMA_BASE_URL=http://localhost:11434
RAGAS_OLLAMA_CHAT_MODEL=gemma3:4b
RAGAS_OLLAMA_EMBEDDING_MODEL=embeddinggemma

# OpenAI judge. The same OPENAI_API_KEY above is used.
RAGAS_OPENAI_CHAT_MODEL=gpt-5.6-luna
RAGAS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Disable anonymous Ragas usage events for this project.
RAGAS_DO_NOT_TRACK=true

# DeepEval evaluator. This is separate from the Ragas judge above.
DEEPEVAL_JUDGE_PROVIDER=ollama
DEEPEVAL_REQUEST_TIMEOUT_SECONDS=180
DEEPEVAL_MAX_CONCURRENT=4

# Local DeepEval judge through DeepEval's OllamaModel adapter.
DEEPEVAL_OLLAMA_BASE_URL=http://localhost:11434
DEEPEVAL_OLLAMA_MODEL=gemma3:4b

# OpenAI DeepEval judge. The same OPENAI_API_KEY above is used.
DEEPEVAL_OPENAI_MODEL=gpt-5.6

# Diagnostic starting thresholds. Calibrate with human labels before release gating.
DEEPEVAL_THRESHOLD_ANSWER_RELEVANCY=0.70
DEEPEVAL_THRESHOLD_FAITHFULNESS=0.70
DEEPEVAL_THRESHOLD_CONTEXTUAL_PRECISION=0.70
DEEPEVAL_THRESHOLD_CONTEXTUAL_RECALL=0.70
DEEPEVAL_THRESHOLD_CONTEXTUAL_RELEVANCY=0.70
DEEPEVAL_THRESHOLD_POLICY_CORRECTNESS=0.70

# Keep project evaluation local and configuration explicit.
DEEPEVAL_DISABLE_DOTENV=1
DEEPEVAL_TELEMETRY_OPT_OUT=1
DEEPEVAL_NO_INSPECT_PROMPT=1

# LangSmith observability and experiment platform. A local dry run with
# upload_results=False does not require a LangSmith account or API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=payroll-mfa-rag-observability
LANGSMITH_DATASET=payroll-mfa-rag-golden-v1
LANGSMITH_MAX_CONCURRENCY=2

# When false, the SDK client masks hosted trace inputs and outputs. Dataset
# synchronization still uploads the selected dataset examples, so review that
# payload separately. Set true for the synthetic workshop corpus when learners
# need to inspect questions, retrieved evidence, prompts, and answers in the UI.
LANGSMITH_CAPTURE_CONTENT=false

# Continuous online-evaluation lab metadata. Keep these stable within one
# comparison so traces remain attributable to the same deployed configuration.
CONTINUOUS_EVAL_ENVIRONMENT=workshop
CONTINUOUS_EVAL_RELEASE_ID=candidate-v1
CONTINUOUS_EVAL_PROMPT_VERSION=payroll-mfa-system-v1
CONTINUOUS_EVAL_SEMANTIC_SAMPLE_RATE=1.0
